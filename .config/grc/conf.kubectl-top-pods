# kubectl top pods
# Columns: [NAMESPACE]  NAME | POD NAME  CPU(cores)  MEMORY(bytes)
# CPU: under 100m green, 100-499m yellow, 500m and up red.
# Memory: under 256Mi green, 256-1023Mi yellow, 1024Mi and up red.

# Header
regexp=^(NAMESPACE|NAME|POD)\s.*
colours=bold
count=stop
=====
# Errors, e.g. metrics API not available
regexp=^error:.*
colours=red
count=stop
=====
# NAMESPACE POD CONTAINER (top pods -A --containers)
regexp=^(\S+)\s+(\S+)\s+(\S+)\s+\d+m\s
colours=unchanged,cyan,bold,yellow
=====
# NAMESPACE NAME (top pods -A), or POD CONTAINER (top pods --containers)
regexp=^(\S+)\s+(\S+)\s+\d+m\s
colours=unchanged,cyan,bold
=====
# NAME (top pods)
regexp=^(\S+)\s+\d+m\s
colours=unchanged,bold
=====
# CPU in millicores
regexp=\s([0-9]{1,2}m)\b
colours=unchanged,green
=====
regexp=\s([1-4][0-9]{2}m)\b
colours=unchanged,yellow
=====
regexp=\s((?:[5-9][0-9]{2}|[0-9]{4,})m)\b
colours=unchanged,red
=====
# Memory
regexp=\s([0-9]+Ki)\b
colours=unchanged,green
=====
regexp=\s((?:[0-9]{1,2}|1[0-9]{2}|2[0-4][0-9]|25[0-5])Mi)\b
colours=unchanged,green
=====
regexp=\s((?:25[6-9]|2[6-9][0-9]|[3-9][0-9]{2}|10[01][0-9]|102[0-3])Mi)\b
colours=unchanged,yellow
=====
regexp=\s((?:102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[0-9]{5,})Mi)\b
colours=unchanged,red
=====
regexp=\s([0-9]+(?:Gi|Ti))\b
colours=unchanged,red
