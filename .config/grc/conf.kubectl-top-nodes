# kubectl top nodes
# Columns: NAME  CPU(cores)  CPU(%)  MEMORY(bytes)  MEMORY(%)
# Percentages: under 50 green, 50-79 yellow, 80-94 red, 95 and up bold red.

# Header
regexp=^NAME\s.*
colours=bold
count=stop
=====
# Errors, e.g. metrics API not available
regexp=^error:.*
colours=red
count=stop
=====
# Node name
regexp=^(\S+)\s
colours=unchanged,bold
count=once
=====
# CPU in millicores
regexp=\s(\d+m)\b
colours=unchanged,cyan
=====
# Memory
regexp=\s(\d+(?:Ki|Mi|Gi|Ti))\b
colours=unchanged,blue
=====
# Node without metrics yet
regexp=<unknown>
colours=bright_black
=====
# Percentages
regexp=\s((?:[1-4]?[0-9])%)
colours=unchanged,green
=====
regexp=\s([5-7][0-9]%)
colours=unchanged,yellow
=====
regexp=\s((?:8[0-9]|9[0-4])%)
colours=unchanged,red
=====
regexp=\s((?:9[5-9]|[1-9][0-9]{2,})%)
colours=unchanged,bold red
